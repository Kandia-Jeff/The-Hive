<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/ic_launcher_background"
        android:backgroundTint="?attr/colorOutline" />

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contact Landlord"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tvLandlordInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Choose how you would like to reach out:"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Message preview card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Message Preview:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvMessagePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hi, I am inquiring about..."
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Email Option -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmailChannel"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="start|center_vertical"
        android:paddingVertical="12dp"
        android:text="Send Email"
        app:icon="@drawable/ic_email"
        app:iconPadding="16dp"
        app:iconTint="?attr/colorPrimary" />

    <!-- SMS Option -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSmsChannel"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="start|center_vertical"
        android:paddingVertical="12dp"
        android:text="Send SMS"
        app:icon="@drawable/ic_sms"
        app:iconPadding="16dp"
        app:iconTint="?attr/colorPrimary" />

    <!-- WhatsApp Option -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWhatsAppChannel"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="start|center_vertical"
        android:paddingVertical="12dp"
        android:text="Send WhatsApp Message"
        app:icon="@drawable/ic_whatsapp"
        app:iconPadding="16dp"
        app:iconTint="#FF25D366" />

</LinearLayout>
